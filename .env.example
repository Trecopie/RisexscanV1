# Server-side Gemini API key (if used)
GEMINI_API_KEY=
PORT=3000

# Optional durable PostgreSQL database connection (Neon/Supabase/PostgreSQL).
# Set this in your hosting dashboard as a SECRET, not in this committed file.
# Without this, all history remains an ephemeral on-disk fallback.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# 700 MB free Postgres soft ceiling (never store 1 GB of raw trades blindly)
RISEX_DB_SOFT_LIMIT_BYTES=700000000
# GitHub public scheduled market sampler uses the same DATABASE_URL secret.
# See docs/zero-cost-deployment.md
